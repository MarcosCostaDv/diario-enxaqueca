# Copie para .streamlit/secrets.toml (NUNCA versione o arquivo real).

# --- Opção A: um usuário só -------------------------------------------
APP_PASSWORD = "troque-por-uma-senha-forte"
# Identificador pseudônimo do usuário. Não use nome nem e-mail.
USER_ID = "u-0001"

# --- Opção B: vários usuários (se existir, substitui a opção A) --------
# Cada pessoa entra com login + senha e só vê os próprios dados.
# O "id" é o que vai para o banco: pseudônimo, nunca nome ou e-mail.
# Mantenha o id u-0001 para quem já tem registros, senão eles "somem" da tela.
# (formato em uma linha só: pode ficar em qualquer posição do arquivo)
# Pacientes têm "id" e só veem os próprios dados.
# O pesquisador tem papel = "pesquisador", NÃO tem id nem diário, e vê todos os pacientes.
# USUARIOS = { pesquisa = { senha = "senha-forte-0", papel = "pesquisador" }, marcos = { senha = "senha-forte-1", id = "u-0001" }, participante2 = { senha = "senha-forte-2", id = "u-0002" } }
FUSO = "America/Sao_Paulo"

# Local (padrão, se omitido): sqlite:///diario.db
# Nuvem (PostgreSQL gerenciado, ex. Neon ou Supabase):
# DATABASE_URL = "postgresql+psycopg://usuario:senha@host:5432/banco?sslmode=require"

# Nomes que aparecem como botões de medicação
MEDICACOES = ["Analgésico comum", "Anti-inflamatório", "Triptano", "Outro"]
