# Modelo de configuração. Copie para .streamlit/secrets.toml (arquivo que NUNCA vai para o Git)
# e troque todos os valores de exemplo.

# --- Contas -------------------------------------------------------------
# Pacientes têm "id" (código pseudônimo gravado no banco) e só veem os próprios dados.
# O pesquisador tem papel = "pesquisador", não tem "id" nem diário, e vê todos os pacientes.
# Use senhas longas e diferentes para cada conta. Nunca use nome ou e-mail no "id".
# Não troque o "id" de quem já tem registros: os dados deixam de aparecer para a pessoa.
USUARIOS = { pesquisador1 = { senha = "TROQUE-ESTA-SENHA-0", papel = "pesquisador" }, paciente1 = { senha = "TROQUE-ESTA-SENHA-1", id = "CODIGO-PACIENTE-1" }, paciente2 = { senha = "TROQUE-ESTA-SENHA-2", id = "CODIGO-PACIENTE-2" } }

# Alternativa com uma conta só (usada apenas se USUARIOS não existir):
# APP_PASSWORD = "TROQUE-ESTA-SENHA"
# USER_ID = "CODIGO-PACIENTE-1"

# --- Região e banco -----------------------------------------------------
FUSO = "America/Sao_Paulo"

# Sem esta linha, o app usa SQLite local (diario.db).
# Em produção, use um PostgreSQL gerenciado com o prefixo postgresql+psycopg://
# DATABASE_URL = "postgresql+psycopg://USUARIO:SENHA@HOST/BANCO?sslmode=require"

# --- Opções do formulário -------------------------------------------------
MEDICACOES = ["Analgésico comum", "Anti-inflamatório", "Triptano", "Outro"]
